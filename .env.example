# Copy to .env and change these before using on a real garage.
PORT=8787
GARAGE_PIN=1234
SESSION_HOURS=12

# How the server triggers your opener:
#   simulate  — demo only (no hardware)
#   webhook   — POST to WEBHOOK_URL (Home Assistant, ESP32, Shelly, etc.)
#   mqtt      — publish to an MQTT topic (requires mqtt package + broker)
DRIVER=simulate

# Required when DRIVER=webhook
WEBHOOK_URL=
WEBHOOK_OPEN_BODY={"action":"open"}
WEBHOOK_CLOSE_BODY={"action":"close"}
WEBHOOK_TOGGLE_BODY={"action":"toggle"}
WEBHOOK_HEADERS={"Authorization":"Bearer YOUR_TOKEN"}
