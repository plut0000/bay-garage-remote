# Copy to .env and change these before using on a real garage.
PORT=8787
GARAGE_PIN=1234
SESSION_HOURS=12

# How the server triggers your opener:
#   esp       — talk to Bay relay (mock-relay.js locally, or ESP32 firmware)
#   simulate  — UI-only demo (no relay)
#   webhook   — POST to WEBHOOK_URL (Home Assistant, Shelly, etc.)
DRIVER=esp

# Required when DRIVER=esp
ESP_URL=http://127.0.0.1:8788
DEVICE_KEY=bay-dev-key
PULSE_MS=500

# mock-relay.js port (npm start runs this automatically)
RELAY_PORT=8788

# Required when DRIVER=webhook
WEBHOOK_URL=
WEBHOOK_OPEN_BODY={"action":"open"}
WEBHOOK_CLOSE_BODY={"action":"close"}
WEBHOOK_TOGGLE_BODY={"action":"toggle"}
WEBHOOK_HEADERS={"Authorization":"Bearer YOUR_TOKEN"}
